
#include <iostream>
#include <queue>
using namespace std;

int main() {
    int n, edges;
    int graph[10][10] = {0};
    int visited[10] = {0};

    cout << "Enter number of vertices: ";
    cin >> n;

    cout << "Enter number of edges: ";
    cin >> edges;

    cout << "Enter edges (source destination):" << endl;

    for (int i = 0; i < edges; i++) {
        int u, v;
        cin >> u >> v;

        graph[u][v] = 1;
        graph[v][u] = 1;
    }

    int start;
    cout << "Enter starting vertex: ";
    cin >> start;

    queue<int> q;

    visited[start] = 1;
    q.push(start);

    cout << "BFS Traversal: ";

    while (!q.empty()) {
        int current = q.front();
        q.pop();

        cout << current << " ";

        for (int i = 0; i < n; i++) {
            if (graph[current][i] == 1 &&
                visited[i] == 0) {

                visited[i] = 1;
                q.push(i);
            }
        }
    }

    return 0;
}
