
#include <iostream>
using namespace std;

int main() {
    int arr[3][3];
    int smallest;

    cout << "Enter 9 elements of matrix:" << endl;

    // Input elements
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            cin >> arr[i][j];
        }
    }

    smallest = arr[0][0];

    // Find smallest element
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            if (arr[i][j] < smallest) {
                smallest = arr[i][j];
            }
        }
    }

    cout << "Smallest element = " << smallest;

    return 0;
}
