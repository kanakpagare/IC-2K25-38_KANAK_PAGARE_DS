
#include <iostream>
using namespace std;

int main() {
    int arr[3][3];
    int largest;

    cout << "Enter 9 elements of matrix:" << endl;

    // Input elements
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            cin >> arr[i][j];
        }
    }

    largest = arr[0][0];

    // Find largest element
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            if (arr[i][j] > largest) {
                largest = arr[i][j];
            }
        }
    }

    cout << "Largest element = " << largest;

    return 0;
}
